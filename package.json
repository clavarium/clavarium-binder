{
  "name": "clavarium-binder",
  "version": "0.1.42-next.1",
  "description": "Clavarium Binder: lists of records kept together by people and AI agents, each with its id (a command and an MCP server for agents, a keeper and a screen for the application). No dependency.",
  "license": "MIT",
  "homepage": "https://github.com/clavarium/clavarium-binder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clavarium/clavarium-binder.git"
  },
  "type": "module",
  "bin": {
    "binder": "bin/binder.mjs",
    "binder-mcp": "server/binder.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "host/",
    "ui/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm run check:hooks && npm run check:shapes && npm run check:names && npm run check:shell && npm test",
    "check:shapes": "node tools/check-shapes.mjs",
    "check:names": "node tools/check-ai-names.mjs",
    "check:shell": "node tools/check-shell.mjs",
    "check:hooks": "node tools/check-hooks.mjs",
    "hooks": "git config core.hooksPath hooks",
    "test": "node --test \"test/*.test.mjs\""
  },
  "exports": {
    "./host": "./host/binder-host.mjs",
    "./serve": "./host/binder-serve.mjs",
    "./server": "./server/binder.mjs",
    "./store": "./server/store.mjs",
    "./templates": "./server/templates.mjs",
    "./ui": "./ui/binder-ui.js",
    "./ui.css": "./ui/binder-ui.css",
    "./ui/texts/*": "./ui/texts/*"
  }
}
